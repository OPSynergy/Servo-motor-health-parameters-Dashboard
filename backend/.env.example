# MQTT broker URL – must match where you see topics (e.g. mosquitto_sub). Use same host:port as your terminal.
# Examples: mqtt://localhost:1883  or  mqtt://192.168.1.100:1883  or  mqtt://broker.hivemq.com:1883
MQTT_URL=mqtt://localhost:1883

# MQTT topic to subscribe to – must match the topic you see in your terminal (e.g. esp/live or device/telemetry)
MQTT_TOPIC=esp/live

# Set to 1 to log every MQTT message in the backend console (for debugging payload format)
# DEBUG_MQTT=1

# Predictive data (real-time graph) – broker and topic for plant/line1/servo01/predictive_data
PREDICTIVE_MQTT_URL=mqtt://192.168.137.1:1883
PREDICTIVE_MQTT_TOPIC=plant/line1/servo01/predictive_data
