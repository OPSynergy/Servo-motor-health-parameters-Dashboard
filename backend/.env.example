# MQTT broker URL (your ESP or broker). Example: mqtt://broker.hivemq.com:1883 or mqtt://192.168.1.100:1883
MQTT_URL=mqtt://localhost:1883

# MQTT topic your ESP publishes to (default: esp/live)
MQTT_TOPIC=esp/live

# Predictive data (real-time graph) – broker and topic for plant/line1/servo01/predictive_data
PREDICTIVE_MQTT_URL=mqtt://192.168.137.1:1883
PREDICTIVE_MQTT_TOPIC=plant/line1/servo01/predictive_data
